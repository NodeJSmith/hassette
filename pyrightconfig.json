        "tests/unit/core/test_duration_hold_predicate_failure.py",
        "tests/unit/core/test_event_filter.py",
        "tests/unit/core/test_execution_timeout.py",
        "tests/unit/core/test_hassette_timeout_warning.py",
        "tests/unit/core/test_log_records.py",
        "tests/unit/core/test_logging_service.py",
        "tests/unit/core/test_loop_watchdog.py",
        "tests/unit/core/test_manifest_repository.py",
        "tests/unit/core/test_runtime_query_service.py",
        "tests/unit/core/test_scheduler_service_dequeue.py",
