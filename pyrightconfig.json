{
    "include": [
        "src",
        "examples",
        "scripts",
        "codegen",
        "wire",
        "client",
        "tools",
        "tests"
    ],
    "ignore": [
        "**/node_modules",
        "**/__pycache__",
        "**/.venv",
        // Intentionally wrong probe files with their own pyrightconfig.json; ignored permanently.
        "tests/pyright_probes",
        // Test files with known type errors (#1271). Each fix issue removes its own entries;
        // test files not listed here are type-checked.
        "tests/e2e/mock_fixtures/telemetry.py",
        "tests/e2e/test_navigation.py",
        "tests/e2e/test_websocket.py",
        "tests/integration/telemetry/test_global_jobs_and_service_info.py",
        "tests/integration/telemetry/test_telemetry_execution_id.py",
        "tests/integration/test_dashboard_without_ha.py",
        "tests/integration/test_registration.py",
        "tests/integration/test_scheduler_entity_time.py",
        "tests/integration/test_scheduler_error_handler.py",
        "tests/integration/test_scheduler_mode_dispatch_edge_cases.py",
        "tests/integration/test_scheduler_mode_overlap.py",
        "tests/integration/test_scheduler_mode_resolution.py",
        "tests/integration/test_scheduler_stale_job_timing.py",
        "tests/integration/test_thread_leaked_observability.py",
        "tests/integration/web_api/test_telemetry.py",
        "tests/support/web_job_helpers.py",
        "tests/support/web_manifest_helpers.py",
        "tests/unit/test_execution_mode_helpers.py",
        "tests/unit/test_scheduler_job_names.py",
        "tests/unit/test_scheduler_resource.py",
        "tests/unit/web/test_mappers.py"
    ],
    // pytest fixtures are registered by decorator and never referenced by name.
    // extraPaths keeps the repo root importable, so `import tests.support...` still resolves
    // once the environment's root moves to tests/. Everything outside tests/ uses the root config.
    "executionEnvironments": [
        {
            "root": "tests",
            "extraPaths": ["."],
            "reportUnusedFunction": "none"
        }
    ],
    "venvPath": ".",
    "venv": ".venv",
    "typeCheckingMode": "basic",
    "analyzeUnannotatedFunctions": true,
    "disableBytesTypePromotions": true,
    "strictParameterNoneValue": true,
    "enableTypeIgnoreComments": true,
    "enableReachabilityAnalysis": false,
    "strictListInference": false,
    "strictDictionaryInference": false,
    "strictSetInference": false,
    "deprecateTypingAliases": false,
    "enableExperimentalFeatures": false,
    "reportMissingTypeStubs": "none",
    "reportMissingModuleSource": "warning",
    "reportInvalidTypeForm": "warning",
    "reportMissingImports": "warning",
    "reportPrivateImportUsage": "error",
    ///
    // errors
    //
    "reportUndefinedVariable": "error",
    "reportCallIssue": "error",
    "reportAssertAlwaysTrue": "error",
    "reportInvalidStringEscapeSequence": "error",
    "reportUnsupportedDunderAll": "error",
    "reportWildcardImportFromLibrary": "error",
    "reportAbstractUsage": "error",
    "reportAssertTypeFailure": "error",
    "reportInconsistentOverload": "error",
    "reportNoOverloadImplementation": "error",
    "reportOptionalCall": "error",
    "reportOptionalContextManager": "error",
    "reportOptionalOperand": "error",
    "reportRedeclaration": "error",
    "reportUnboundVariable": "error",
    "reportUnhashable": "error",
    "reportUnusedCoroutine": "error",
    "reportUnusedExcept": "error",
    "reportFunctionMemberAccess": "error",
    "reportConstantRedefinition": "error",
    "reportDuplicateImport": "error",
    "reportIncompleteStub": "error",
    "reportInconsistentConstructor": "error",
    "reportInvalidStubStatement": "error",
    "reportMatchNotExhaustive": "error",
    "reportTypeCommentUsage": "error",
    "reportUnnecessaryCast": "error",
    "reportUnnecessaryContains": "error",
    "reportUnusedClass": "error",
    "reportUnusedImport": "error",
    "reportUnusedFunction": "error",
    "reportUnusedVariable": "error",
    "reportUntypedBaseClass": "error",
    "reportUntypedClassDecorator": "error",
    "reportUntypedNamedTuple": "error",
    "reportCallInDefaultInitializer": "error",
    "reportPropertyTypeMismatch": "error",
    "reportAttributeAccessIssue": "error",
    "reportSelfClsParameterName": "error",
    "reportGeneralTypeIssues": "error",
    //
    // TODO: evaluate these
    //
    // "reportUnusedExpression": "none",
    // "reportTypedDictNotRequiredAccess": "none",
    // "reportDeprecated": "none",
    // "reportOptionalIterable": "none",
    // "reportInvalidTypeArguments": "none",
    // "reportOverlappingOverload": "none",
    // "reportUnnecessaryTypeIgnoreComment": "none",
    // "reportPossiblyUnboundVariable": "none",
    // "reportInvalidTypeVarUse": "none",
    // "reportOperatorIssue": "none",
    // "reportOptionalSubscript": "none",
    // "reportUnknownLambdaType": "none",
    // "reportPrivateUsage": "none",
    // "reportUntypedFunctionDecorator": "none",
    // "reportImplicitStringConcatenation": "none",
    // "reportIncompatibleMethodOverride": "none",
    // "reportIncompatibleVariableOverride": "none",
    // "reportImportCycles": "none",
    // "reportMissingSuperCall": "none",

    "reportUnnecessaryComparison": "error",

    // "reportUnnecessaryIsInstance": "none",
    // "reportUninitializedInstanceVariable": "none",
    // "reportMissingParameterType": "none",
    // "reportOptionalMemberAccess": "none",
    // "reportIndexIssue": "none",
    // "reportAssignmentType": "none",
    // "reportReturnType": "none",
    // "reportUnusedCallResult": "none",
    // "reportImplicitOverride": "none",
    // "reportMissingTypeArgument": "none",
    // "reportUnknownParameterType": "none",
    // "reportArgumentType": "none",
    // "reportUnknownVariableType": "none",
    // "reportUnknownArgumentType": "none",
    // "reportUnknownMemberType": "none"
}
