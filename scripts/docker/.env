# Single source of truth for the demo/system-test HA image tag, the
# hass-hassette release pin, and shared credentials. Every value here is fixture-only demo/dev material (not a real
# secret) -- see the comments below -- so this file is committed despite the
# blanket .env ignore rule in .gitignore (explicit negation there).
#
# Consumed by:
#   - scripts/docker/ha-demo.yml (docker-compose auto-loads this file since it
#     sits next to the compose file)
#   - scripts/docker/hass-hassette.yml (HA_VERSION and HASS_HASSETTE_VERSION,
#     interpolated by whichever compose file extends it)
#   - tests/system/docker-compose.yml (tests/system/.env symlinks here, for
#     the same auto-load reason, since docker-compose loads .env from the
#     compose file's own directory, not the invoking shell's cwd)
#   - scripts/capture_screenshots.py (reads DEMO_AUTH_TOKEN via python-dotenv)
#   - .mise/tasks/demo-verify (reads DEMO_AUTH_TOKEN via grep)
#   - tests/system/conftest.py (reads HA_ACCESS_TOKEN, SYSTEM_HA_PORT and
#     HASS_HASSETTE_VERSION via python-dotenv, from the tests/system/.env symlink)
#   - scripts/demo_stack.py (pins HA_ACCESS_TOKEN, DEMO_AUTH_TOKEN and
#     HASS_HASSETTE_VERSION into the compose environment)
#   - renovate.json (a regex customManager bumps HASS_HASSETTE_VERSION)

# Minor-only HA image tag (Home Assistant images are tagged YYYY.M, not
# YYYY.M.PATCH). .claude/skills/ha-version-bump/SKILL.md is the sole owner of
# this value and keeps it in lockstep with codegen/ha-version.txt's full
# patch pin on each monthly bump.
HA_VERSION=2026.10

# Release tag of the hass-hassette companion integration (github.com/NodeJSmith/hass-hassette)
# that the system-test and demo HA containers install (scripts/docker/hass-hassette.yml).
# Renovate bumps it (customManagers in renovate.json); tests/system/test_hass_hassette.py is
# the check that a new release still works against this repo's hassette.
HASS_HASSETTE_VERSION=v0.1.0

# Long-lived HA access token baked into
# tests/fixtures/demo-ha-config/.storage/auth (signed with an all-zeros
# fixture key -- not a real secret).
HA_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiIwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMyIsImlhdCI6MTczNTY4OTYwMCwiZXhwIjoyMDUxMDQ5NjAwfQ.q-p85dOe-MMnKQhSNh_LEWnWJGK-GA3xdmqb4LKvkU0

# hassette's own local demo/dev web API auth token.
DEMO_AUTH_TOKEN=demo-token

# Host port the system-test HA container publishes 8123 on. Read by both
# tests/system/docker-compose.yml (port mapping) and tests/system/conftest.py
# (HA_URL), so the two cannot drift. 18123 avoids colliding with a real HA on 8123.
SYSTEM_HA_PORT=18123
