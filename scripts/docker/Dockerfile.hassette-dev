FROM python:3.14.8-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /bin/uv

ARG UID=1000
ARG GID=1000
RUN (getent group "$GID" >/dev/null 2>&1 || groupadd --gid "$GID" hassette) \
    && useradd --uid "$UID" --gid "$GID" --create-home hassette \
    && mkdir -p /opt/venv \
    && chown hassette:hassette /opt/venv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv
USER hassette
WORKDIR /app
# The run command lives in ha-demo.yml, so changing it never needs an image rebuild
# (DemoStack runs `compose up` without --build and reuses a cached image).
