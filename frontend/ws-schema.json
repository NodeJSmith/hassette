    "ServiceStatusWsMessage": {
      "properties": {
        "type": {
          "const": "service_status",
          "title": "Type",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ServiceStatusData"
        },
        "timestamp": {
